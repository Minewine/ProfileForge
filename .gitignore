# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ProfileForge
uploads/
.appsecret
*.tsbuildinfo
next-env.d.ts
src/generated/
uploads-test/

# E2E suite (spec 004)
uploads-e2e/
test-results/
playwright-report/
tests/e2e/.seed-state.json

# E2E auth state (specs/008)
tests/e2e/.auth-state.json
gui-test-screenshots/
uploads-e2e/

# Benchmark (spec 009) — run reports & uploads are local artifacts;
# baselines, fixtures, and transcripts stay committed
benchmarks/runs/
uploads-benchmark/
