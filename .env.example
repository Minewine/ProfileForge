# PostgreSQL (see docker-compose.yml: docker compose up -d; mapped to host port 5435 —
# 5433 is avoided because other local projects use it)
DATABASE_URL="postgresql://profileforge:profileforge@localhost:5435/profileforge"

# OpenRouter API key (env var takes precedence over a key saved in Settings)
OPENROUTER_API_KEY=""

# 32+ chars; used to encrypt a Settings-stored key. If empty, a .appsecret file is auto-generated.
APP_SECRET=""

# Where uploaded CV files are stored (default ./uploads)
UPLOADS_DIR="./uploads"
