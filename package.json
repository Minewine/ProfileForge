{
  "name": "scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "fixtures": "node scripts/make-fixtures.mjs",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "e2e:install": "npx playwright install chromium",
    "test:e2e": "docker compose up -d e2e-db && node tests/e2e/scripts/reset-db.mjs && playwright test",
    "db:assign-owner": "tsx scripts/assign-owner.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "docx": "^9.13.0",
    "franc": "^6.2.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
